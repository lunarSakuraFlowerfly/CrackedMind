  dialogueID: 001
  startNodeID: node_01
  speakers:
  - speakerID: doctor
    speakerName: "\u533B\u751F"
    speakerType: 0
    portrait: {fileID: -1463788318, guid: 72c4487d4f3df524292efcd8665a35e2, type: 3}
  - speakerID: player
    speakerName: "\u6211"
    speakerType: 1
    portrait: {fileID: -1463788318, guid: 72c4487d4f3df524292efcd8665a35e2, type: 3}
  - speakerID: neighbor
    speakerName: "\u90BB\u5C45"
    speakerType: 0
    portrait: {fileID: -1463788318, guid: 72c4487d4f3df524292efcd8665a35e2, type: 3}
  nodes:
  - nodeID: node_01
    speakerID: doctor
    text: "\u4F60\u597D\uFF0C\u6211\u662F\u5FC3\u7406\u533B\u751F\u7684\u540D\u5B57\u5FC3\u7406\u533B\u751F\u987E\u6052\u3002\u4E4B\u524D\u548C\u4F60\u901A\u8FC7\u90BB\u5C45\u6709\u8FC7\u7B80\u77ED\u7684\u6C9F\u901A\uFF0C\u8FD9\u6B21\u6211\u7279\u5730\u8FC7\u6765\u770B\u4F60\uFF0C\u60F3\u5E2E\u4F60\u7F13\u89E3\u4E00\u4E0B\u76EE\u524D\u7684\u72B6\u51B5\u3002"
    nextNodeID: node_02
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_02
    speakerID: player
    text: "\u2026\u4F60\u60F3\u2026\u2026\u600E\u4E48\u5E2E\uFF1F"
    nextNodeID: node_03
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_03
    speakerID: doctor
    text: "\u6211\u60F3\u95EE\u4F60\u4E00\u4E9B\u76EE\u524D\u751F\u6D3B\u7684\u57FA\u672C\u72B6\u51B5\uFF0C\u53EF\u4EE5\u5417\uFF1F "
    nextNodeID: node_04
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_04
    speakerID: player
    text: "\u4F60\u95EE\u5427\u3002"
    nextNodeID: node_05
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_05
    speakerID: doctor
    text: "\u6700\u8FD1\u4F60\u7684\u7761\u7720\u600E\u4E48\u6837\uFF1F\u662F\u4E0D\u662F\u7ECF\u5E38\u505A\u5669\u68A6\uFF0C\u6216\u8005\u5E72\u8106\u7761\u4E0D\u7740\uFF1F"
    nextNodeID: node_06
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_06
    speakerID: player
    text: "\u2026\u2026\u90FD\u662F\u4E9B\u2026\u2026\u5F88\u53EF\u6015\u7684\u68A6\u3002"
    nextNodeID: node_07
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_07
    speakerID: doctor
    text: "\u4F60\u73B0\u5728\u7684\u98DF\u6B32\u5982\u4F55\uFF1F\u6709\u6CA1\u6709\u7ECF\u5E38\u611F\u5230\u80F8\u95F7\u3001\u5FC3\u614C\uFF0C\u6216\u8005\u83AB\u540D\u7684\u6050\u60E7\uFF1F"
    nextNodeID: node_08
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_08
    speakerID: player
    text: "\u2026\u4E0D\u60F3\u5403\u4E1C\u897F\u2026\u2026\u6709\u65F6\u5019\u7A81\u7136\u5FC3\u8DF3\u7279\u522B\u5FEB\u2026\u2026 "
    nextNodeID: node_09
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_09
    speakerID: neighbor
    text: "\u4ED6\u7684\u7126\u8651\u548C\u6291\u90C1\u60C5\u7EEA\u53E0\u52A0\u5F88\u4E25\u91CD\uFF0CPTSD\u75C7\u72B6\u660E\u663E\u3002\u5728\u8FD9\u79CD\u72B6\u6001\u4E0B\uFF0C\u5F88\u96BE\u6307\u671B\u4ED6\u81EA\u5DF1\u8D70\u51FA\u5BB6\u95E8\u3002"
    nextNodeID: node_10
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_10
    speakerID: neighbor
    text: "\u6240\u4EE5\u4F60\u80FD\u505A\u4E9B\u4EC0\u4E48\uFF1F\u4ED6\u8FD9\u6837\u771F\u7684\u8BA9\u6211\u5F88\u62C5\u5FC3\u2026\u2026"
    nextNodeID: node_11
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_11
    speakerID: doctor
    text: "\u5148\u5C1D\u8BD5\u4E00\u4E9B\u975E\u4FB5\u5165\u5F0F\u7684\u5E72\u9884\u5427\u3002\u8BA9\u6211\u5148\u548C\u4ED6\u8FDB\u884C\u66F4\u6DF1\u5165\u7684\u4EA4\u6D41\uFF0C\u770B\u770B\u80FD\u4E0D\u80FD\u5E2E\u4ED6\u7A33\u5B9A\u60C5\u7EEA\u3002"
    nextNodeID: node_12
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  lastNodeCount: 11
