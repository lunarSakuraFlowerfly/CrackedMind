  nodes:
  - nodeID: node_01
    speakerID: doctor
    text: "\u6211\u6CE8\u610F\u5230\u4F60\u4E00\u76F4\u5728\u73A9\u6E38\u620F\u2026\u2026\u8FD9\u662F\u4F60\u51CF\u8F7B\u75DB\u82E6\u7684\u65B9\u5F0F\uFF0C\u5BF9\u5417\uFF1F"
    nextNodeID: node_02
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_02
    speakerID: player
    text: "\u2026\u2026\u81F3\u5C11\u5728\u6E38\u620F\u91CC\uFF0C\u6211\u4E0D\u4F1A\u60F3\u5230\u90A3\u4E9B\u4E8B\u2026\u2026\u5076\u5C14\u80FD\u5FD8\u8BB0\u4E00\u70B9\u3002"
    nextNodeID: node_03
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_03
    speakerID: doctor
    text: "\u8FD9\u5F88\u6B63\u5E38\uFF0C\u4EBA\u4EEC\u90FD\u4F1A\u60F3\u529E\u6CD5\u9003\u907F\u75DB\u82E6\u3002\u4E0D\u8FC7\uFF0C\u6211\u4EEC\u53EF\u80FD\u8FD8\u9700\u8981\u4E00\u4E9B\u66F4\u76F4\u63A5\u7684\u65B9\u6CD5\uFF0C\u6765\u9762\u5BF9\u4F60\u7684\u5669\u68A6\u3002"
    nextNodeID: node_04
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_04
    speakerID: neighbor
    text: "\u5979\u5F88\u5C11\u51FA\u623F\u95F4"
    nextNodeID: node_05
    choices: []
    voiceClip: {fileID: 0}
    lastChoiceCount: 0
  - nodeID: node_05
    speakerID: doctor
    text: "\u597D\u7684\uFF0C\u7406\u89E3\u3002\u65E2\u7136\u4ED6\u77ED\u671F\u5185\u65E0\u6CD5\u51FA\u95E8\uFF0C\u90A3\u6211\u5C31\u8FD9\u91CC\u5F53\u4E00\u9635\u2018\u8BCA\u5BA4\u2019\u5427\u3002\u6211\u9700\u8981\u505A\u4E00\u4E2A\u66F4\u7CFB\u7EDF\u7684\u8BC4\u4F30\u3002"
